+
+// parseOctets handles both plain counts ("12345") and the wrapped 32-bit
+// form some firmware reports ("9 * 2e32 + 868756518", i.e. 9*2^32 + n).
+func parseOctets(s string) int64 {
+	s = strings.TrimSpace(s)
+	if hi, lo, ok := strings.Cut(s, "+"); ok {
+		mult, _, _ := strings.Cut(hi, "*")
+
+		return atoi64(mult)<<32 + atoi64(lo)
+	}
+
+	return atoi64(s)
+}
